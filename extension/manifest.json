{
  "manifest_version": 3,
  "name": "Smart Meeting Assistant — Local Recorder",
  "version": "0.1.0",
  "description": "Ghi âm speaker + mic trong cuộc họp, phiên âm & dịch trực tiếp, tóm tắt điểm chính — 100% xử lý local, dữ liệu không rời máy.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Meeting Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "viewer/viewer.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
