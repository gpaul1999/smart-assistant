{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.7.0",
  "description": "__MSG_extDesc__",
  "default_locale": "vi",
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Meeting Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "viewer/viewer.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
